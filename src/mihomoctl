#!/usr/bin/env bash
set -u

_muc_lib_dir=${MIHOMO_USERCTL_LIB_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/mihomo-userctl}
_muc_common="$_muc_lib_dir/common.bash"
_muc_common_mode=$(stat -c '%a' -- "$_muc_common" 2>/dev/null || true)
_muc_lib_mode=$(stat -c '%a' -- "$_muc_lib_dir" 2>/dev/null || true)
if [[ ! -r $_muc_common || ! -O $_muc_common || ! -O $_muc_lib_dir ]]; then
  printf 'mihomoctl: unsafe or missing runtime module: %s\n' "$_muc_common" >&2
  exit 2
fi
if [[ ! $_muc_common_mode =~ ^[0-7]{3,4}$ || ! $_muc_lib_mode =~ ^[0-7]{3,4}$ ]]; then
  printf 'mihomoctl: could not validate runtime module permissions\n' >&2
  exit 2
fi
if (( (8#$_muc_common_mode & 022) != 0 || (8#$_muc_lib_mode & 022) != 0 )); then
  printf 'mihomoctl: runtime modules must not be writable by group or others\n' >&2
  exit 2
fi
# shellcheck source=common.bash
source "$_muc_common"
unset _muc_common_mode _muc_lib_mode

usage() {
  cat <<'EOF'
Usage: mihomoctl COMMAND [OPTIONS]

Commands:
  start                 Start the user service and wait until authenticated proxying works
  stop                  Stop the user service and wait for its loopback port to be released
  restart               Restart the user service and wait until it is ready
  status                Print a stable one-line service/listener status
  ready                 Test service, listener, credentials, and an authenticated HTTP request
  doctor                Run safe configuration and runtime diagnostics
  codex [-- ARGS...]
                        Launch Codex only when the full preflight permits it
  codex preflight [--json]
                        Decide SAFE_TO_LAUNCH (0), BLOCKED (1), or UNVERIFIED (2)
  exec -- COMMAND [ARGS...]
                        Run one command with validated proxy variables
  direct -- COMMAND [ARGS...]
                        Run one command with all proxy variables removed
  diagnose url URL [--json]
                        Test direct, listener, authentication, and target paths
  diagnose process PID [--json]
                        Inspect one current-user process without exposing values
  diagnose name NAME [--json]
                        Inspect current-user processes with an exact name
  diagnose codex [--json]
                        Explain local Codex proxy state and safe recovery steps (offline)
  rules status [OPTIONS] | rules check [OPTIONS]
                        Inspect the documented custom-rule contract without changes
  controller setup [--port PORT] [--home-dir DIR] [--archive ZIP --sha256 HASH]
                        Back up and validate private controller/UI configuration; no restart
  controller status | controller token
                        Verify controller, or explicitly display secret in a private terminal
  controller initialize [--port PORT] [--home-dir DIR]
                        Initialize only the private loopback API; no dashboard or restart
  nodes | groups | connections | traffic [--json]
                        Inspect nodes, current selections, redacted routes, or one traffic sample
  select GROUP NODE     Select a member of a manual Selector group and verify the result
  latency NODE          Probe one node against a public HTTPS test target
  tui [--engine curses|textual|plain]
                        Chinese task console when Textual is available, otherwise numbered menu
  tui --stdin [--policy provider|nodes]
                        Read private subscription YAML from stdin, then review in the current PTY
  providers | provider refresh NAME
                        Inspect providers or explicitly request a provider download
  dns NAME [TYPE]       Query the core DNS without changing system DNS
  mode rule|global|direct
                        Change only the core runtime mode, with readback confirmation
  subscription preview --source-file FILE | --url-file PRIVATE_FILE | --stdin
                        Add --policy provider to retain provider groups and routing rules
  subscription apply ID --sha256 HASH
                        Default: merge nodes. Provider mode replaces routing; restart separately
  manual GROUP [--apply] Preview or save conversion of an automatic group to manual
  override --script FILE [--apply]
                        Run trusted JS main(config); preview or validate/back up/save policy
  connections --details Opt in to private destination host and matched-rule details
  ui | dashboard        Show local dashboard URL and SSH forwarding instructions
  logs [--lines N] [--follow]
                        Read the user-service journal
  version               Print mihomo-userctl and detected Mihomo versions
  update --check | --version TAG [--dry-run]
                        Update only mihomo-userctl from an official stable release
  help                  Show this help
EOF
}

load_config_or_exit() {
  _muc_load_config || exit 2
}

require_python_module() {
  local path=$1
  _muc_require_safe_module "$path" || exit 2
  command -v python3 >/dev/null 2>&1 || { _muc_err 'this command requires Python 3.8+'; exit 2; }
}

json_error() {
  local command=$1 code=$2
  require_python_module "$_muc_lib_dir/diagnostics.py"
  python3 -B "$_muc_lib_dir/diagnostics.py" error "$command" "$code"
  exit 2
}

require_controller_modules() {
  local module
  for module in controller.py controller_types.py controller_config.py controller_api.py \
    controller_service.py controller_policy.py controller_transaction.py controller_dashboard.py \
    controller_legacy.py controller_state.py controller_runtime.py controller_subscriptions.py \
    controller_textual.py controller_deps.py acceptance.py reporting.py install_support.py; do
    require_python_module "$_muc_lib_dir/$module"
  done
}

cmd_runtime_change() {
  local action=$1
  load_config_or_exit
  require_controller_modules
  exec python3 -B "$_muc_lib_dir/controller_deps.py" --run controller_runtime.py "$action" "$MIHOMO_SERVICE" "$MIHOMO_PORT"
}

cmd_start() {
  cmd_runtime_change start
}

cmd_stop() {
  load_config_or_exit
  systemctl --user stop "$MIHOMO_SERVICE" || exit 1
  if _muc_wait_stopped; then
    printf 'service=down listener=down endpoint=127.0.0.1:%s shell=unchanged\n' "$MIHOMO_PORT"
  else
    printf 'mihomoctl: service stopped but 127.0.0.1:%s remains occupied; no process was killed\n' "$MIHOMO_PORT" >&2
    exit 1
  fi
}

cmd_restart() {
  cmd_runtime_change restart
}

cmd_status() {
  local service=down listener=down enabled json=${1:-0}
  if ! _muc_load_config; then
    (( json )) && json_error status config-invalid
    exit 2
  fi
  _muc_service_active && service=up
  _muc_listening && listener=up
  enabled=$(_muc_service_enabled_state)
  if (( json )); then
    require_python_module "$_muc_lib_dir/diagnostics.py"
    python3 -B "$_muc_lib_dir/diagnostics.py" format status --service "$service" \
      --enabled "$enabled" --listener "$listener" --port "$MIHOMO_PORT"
  else
    printf 'service=%s enabled=%s listener=%s endpoint=127.0.0.1:%s\n' \
      "$service" "$enabled" "$listener" "$MIHOMO_PORT"
    [[ $service == up && $listener == up ]]
  fi
}

cmd_ready() {
  local rc json=${1:-0}
  if ! _muc_load_config; then
    (( json )) && json_error ready config-invalid
    exit 2
  fi
  if _muc_probe; then
    if (( json )); then
      require_python_module "$_muc_lib_dir/diagnostics.py"
      python3 -B "$_muc_lib_dir/diagnostics.py" format ready --ready up --port "$MIHOMO_PORT"
    else
      printf 'ready=up endpoint=127.0.0.1:%s\n' "$MIHOMO_PORT"
    fi
  else
    rc=$?
    if (( json )); then
      (( rc == 2 )) && json_error ready credentials-invalid
      require_python_module "$_muc_lib_dir/diagnostics.py"
      python3 -B "$_muc_lib_dir/diagnostics.py" format ready --ready down --port "$MIHOMO_PORT"
    else
      printf 'ready=down endpoint=127.0.0.1:%s\n' "$MIHOMO_PORT" >&2
    fi
    (( rc == 2 )) && exit 2
    exit 1
  fi
}

doctor_line() {
  printf '%-12s %s\n' "$1" "$2"
}

cmd_doctor() {
  local failed=0 dependency_failed=0 command enabled service=down listener=down
  local offline=${1:-0} json=${2:-0} rc
  local -a checks=()
  for command in bash python3 systemctl ss curl journalctl stat awk grep id; do
    if command -v "$command" >/dev/null 2>&1; then
      (( json )) || doctor_line "$command" ok
      checks+=(--check "$command=PASS")
    else
      (( json )) || doctor_line "$command" missing
      checks+=(--check "$command=FAIL")
      failed=1
      dependency_failed=1
    fi
  done
  if (( json && dependency_failed )) && ! command -v python3 >/dev/null 2>&1; then
    printf '%s\n' '{"command":"doctor","error":{"code":"python3-missing"},"overall":"UNVERIFIED","schema":"mihomo-userctl.diagnostics/v1"}'
    exit 2
  fi
  if ! _muc_load_config; then
    (( json )) && json_error doctor config-invalid
    doctor_line config invalid
    exit 2
  fi
  (( json )) || doctor_line config ok
  checks+=(--check config=PASS)
  if _muc_load_credentials; then
    (( json )) || doctor_line credentials ok
    checks+=(--check credentials=PASS)
  else
    (( json )) && json_error doctor credentials-invalid
    doctor_line credentials invalid
    exit 2
  fi
  _muc_clear_credentials
  enabled=$(_muc_service_enabled_state)
  (( json )) || doctor_line enabled "$enabled"
  if [[ $enabled == disabled || $offline == 1 ]]; then
    checks+=(--check enabled-policy=PASS)
  else
    checks+=(--check enabled-policy=FAIL)
    failed=1
  fi
  _muc_service_active && service=up
  _muc_listening && listener=up
  (( json )) || doctor_line service "$service"
  (( json )) || doctor_line listener "$listener"
  (( json )) || doctor_line endpoint "127.0.0.1:$MIHOMO_PORT"
  if [[ $service == up && $offline == 0 ]]; then
    if _muc_probe; then
      (( json )) || doctor_line readiness ok
      checks+=(--check readiness=PASS)
    else
      (( json )) || doctor_line readiness failed
      checks+=(--check readiness=FAIL)
      failed=1
    fi
  else
    (( json )) || doctor_line readiness skipped-offline-or-service-down
    checks+=(--check readiness=SKIPPED)
  fi
  (( json )) || doctor_line secrets redacted
  checks+=(--check secrets=PASS)
  if (( json )); then
    require_python_module "$_muc_lib_dir/diagnostics.py"
    python3 -B "$_muc_lib_dir/diagnostics.py" format doctor --service "$service" \
      --enabled "$enabled" --listener "$listener" --port "$MIHOMO_PORT" "${checks[@]}"
    rc=$?
    (( dependency_failed )) && return 2
    return "$rc"
  else
    (( dependency_failed )) && return 2
    (( failed == 0 ))
  fi
}

cmd_exec() {
  [[ ${1:-} == -- && $# -ge 2 ]] || { _muc_err 'usage: mihomoctl exec -- command [args...]'; exit 2; }
  shift
  _muc_prepare_proxy_environment || exit $?
  exec -- "$@"
}

cmd_codex() {
  local json=0 preflight=0 option module runtime_ok=1 invalid=0
  local -a options=()
  if [[ ${1:-} == --help || ${1:-} == -h ]]; then
    (( $# == 1 )) || { _muc_err 'usage: mihomoctl codex [-- CODEX_ARGS...]'; return 2; }
    printf 'Usage: mihomoctl codex [-- CODEX_ARGS...]\n       mihomoctl codex preflight [--json]\nLaunch requires SAFE_TO_LAUNCH (0); BLOCKED (1) and UNVERIFIED (2) never launch.\nNo service is started and no existing process is stopped. HTTP readiness is not model verification.\n'
    return 0
  fi
  if [[ ${1:-} == preflight ]]; then
    preflight=1
    shift
    for option in "$@"; do [[ $option == --json ]] && json=1; done
    if (( $# > 1 )) || { (( $# == 1 )) && [[ $1 != --json ]]; }; then
      invalid=1
    fi
    (( json )) && options+=(--json)
  elif (( $# )); then
    [[ $1 == -- ]] || { _muc_err 'usage: mihomoctl codex [-- CODEX_ARGS...]'; return 2; }
    shift
  fi
  command -v python3 >/dev/null 2>&1 || runtime_ok=0
  for module in diagnostics.py acceptance.py reporting.py; do
    _muc_require_safe_module "$_muc_lib_dir/$module" 2>/dev/null || runtime_ok=0
  done
  if (( ! runtime_ok )); then
    if (( json )); then
      printf '%s\n' '{"schema":"mihomo-userctl.diagnostics/v1","command":"codex-preflight","overall":"UNVERIFIED","launch_safe":false,"reasons":["runtime-unavailable"],"error":{"code":"runtime-unavailable"}}'
    fi
    _muc_err 'UNVERIFIED: runtime-unavailable; Python 3 and safe runtime modules are required. Codex was not launched.'
    return 2
  fi
  if (( invalid )); then
    (( json )) && json_error codex-preflight invalid-options
    _muc_err 'usage: mihomoctl codex preflight [--json]'; return 2
  fi
  if ! _muc_load_config 2>/dev/null || ! _muc_load_credentials 2>/dev/null; then
    (( json )) && json_error codex-preflight configuration-or-credentials-invalid
    _muc_err 'UNVERIFIED: configuration-or-credentials-invalid; Codex was not launched. Run mihomoctl doctor.'
    return 2
  fi
  export MIHOMO_SERVICE MIHOMO_PORT MIHOMO_READY_URL
  export MIHOMO_HTTP_PROXY MIHOMO_HTTPS_PROXY MIHOMO_ALL_PROXY
  # One implementation evaluates and launches, keeping secrets out of argv.
  (( preflight )) || options=(--launch "$@")
  exec python3 -B "$_muc_lib_dir/diagnostics.py" codex-preflight "${options[@]}"
}

cmd_direct() {
  [[ ${1:-} == -- && $# -ge 2 ]] || { _muc_err 'usage: mihomoctl direct -- command [args...]'; exit 2; }
  shift
  _muc_clear_proxy_variables
  exec -- "$@"
}

cmd_diagnose_url() {
  local report_command=$1 url='' json=0 argument
  shift
  for argument in "$@"; do
    [[ $argument == --json ]] && json=1
  done
  while (( $# )); do
    case $1 in
      --json) json=1 ;;
      --*) (( json )) && json_error "$report_command" invalid-options; _muc_err 'invalid diagnose url option'; exit 2 ;;
      *) [[ -z $url ]] || { (( json )) && json_error "$report_command" invalid-options; _muc_err 'diagnose url accepts one URL'; exit 2; }; url=$1 ;;
    esac
    shift
  done
  [[ -n $url ]] || { (( json )) && json_error "$report_command" invalid-options; _muc_err 'diagnose url requires one HTTPS URL'; exit 2; }
  if ! _muc_load_config || ! _muc_load_credentials; then
    (( json )) && json_error "$report_command" configuration-or-credentials-invalid
    exit 2
  fi
  require_python_module "$_muc_lib_dir/acceptance.py"
  export MIHOMO_SERVICE MIHOMO_PORT MIHOMO_READY_URL
  export MIHOMO_HTTP_PROXY MIHOMO_HTTPS_PROXY MIHOMO_ALL_PROXY
  local -a options=(--profile test-url --report-command "$report_command" --url "$url" --timeout 10)
  (( json )) && options+=(--json)
  exec python3 -B "$_muc_lib_dir/acceptance.py" "${options[@]}"
}

cmd_diagnose_process() {
  local kind=$1 report_command=$2
  shift 2
  require_python_module "$_muc_lib_dir/diagnostics.py"
  if ! _muc_load_config || ! _muc_load_credentials; then
    [[ " $* " == *' --json '* ]] && json_error "$report_command" configuration-or-credentials-invalid
    exit 2
  fi
  export MIHOMO_HTTP_PROXY MIHOMO_HTTPS_PROXY MIHOMO_ALL_PROXY
  exec python3 -B "$_muc_lib_dir/diagnostics.py" "$kind" "$@" --port "$MIHOMO_PORT" \
    --report-command "$report_command"
}

cmd_diagnose() {
  local kind=${1:-} option
  (( $# > 0 )) && shift
  case $kind in
    url) cmd_diagnose_url diagnose-url "$@" ;;
    process) cmd_diagnose_process process diagnose-process "$@" ;;
    name) cmd_diagnose_process name diagnose-name "$@" ;;
    codex)
      for option in "$@"; do
        [[ $option == --json ]] || {
          [[ " $* " == *' --json '* ]] && json_error diagnose-codex invalid-options
          _muc_err 'usage: mihomoctl diagnose codex [--json]'; exit 2
        }
      done
      cmd_diagnose_process codex diagnose-codex "$@" ;;
    '') _muc_err 'usage: mihomoctl diagnose {url|process|name|codex} ...'; exit 2 ;;
    *)
      if [[ $kind == --json || " $* " == *' --json '* ]]; then
        json_error diagnose invalid-options
      fi
      _muc_err 'unknown diagnose command'
      exit 2
      ;;
  esac
}

cmd_rules() {
  require_python_module "$_muc_lib_dir/rules.py"
  local core
  unset MIHOMO_CORE_BIN
  if core=$(_muc_find_core); then
    export MIHOMO_CORE_BIN=$core
  fi
  exec python3 -B "$_muc_lib_dir/rules.py" "$@"
}

cmd_controller() {
  require_controller_modules
  local module core
  for module in controller.py acceptance.py reporting.py install_support.py; do
    require_python_module "$_muc_lib_dir/$module"
  done
  _muc_require_safe_module "$_muc_lib_dir/dashboard.html" || exit 2
  unset MIHOMO_CORE_BIN
  if core=$(_muc_find_core); then export MIHOMO_CORE_BIN=$core; fi
  exec python3 -B "$_muc_lib_dir/controller_deps.py" --run controller.py "$@"
}

cmd_logs() {
  local lines=50 follow=0
  load_config_or_exit
  while (( $# )); do
    case $1 in
      --lines)
        if (( $# < 2 )) || [[ ! $2 =~ ^[0-9]+$ ]] || (( $2 < 1 || $2 > 10000 )); then
          _muc_err "--lines requires a number between 1 and 10000"
          exit 2
        fi
        lines=$2
        shift 2
        ;;
      --follow|-f)
        follow=1
        shift
        ;;
      *)
        _muc_err "unknown logs option: $1"
        exit 2
        ;;
    esac
  done
  if (( follow )); then
    journalctl --user -u "$MIHOMO_SERVICE" --no-pager -n "$lines" -f
  else
    journalctl --user -u "$MIHOMO_SERVICE" --no-pager -n "$lines"
  fi
}

cmd_version() {
  local core=unavailable core_bin=
  core_bin=$(_muc_find_core 2>/dev/null || true)
  if [[ -n $core_bin ]]; then
    core=$("$core_bin" -v 2>/dev/null | head -n 1 || true)
    [[ -n $core ]] || core=unknown
  fi
  printf 'mihomo-userctl %s\n' "$MIHOMO_USERCTL_VERSION"
  printf 'mihomo %s\n' "$core"
}

command_name=${1:-help}
(( $# == 0 )) || shift
case $command_name in
  start) (( $# == 0 )) || { usage >&2; exit 2; }; cmd_start ;;
  stop) (( $# == 0 )) || { usage >&2; exit 2; }; cmd_stop ;;
  restart) (( $# == 0 )) || { usage >&2; exit 2; }; cmd_restart ;;
  status)
    if (( $# == 0 )); then cmd_status 0
    elif (( $# == 1 )) && [[ $1 == --json ]]; then cmd_status 1
    elif [[ " $* " == *' --json '* ]]; then json_error status invalid-options
    else usage >&2; exit 2; fi ;;
  ready)
    if (( $# == 0 )); then cmd_ready 0
    elif (( $# == 1 )) && [[ $1 == --json ]]; then cmd_ready 1
    elif [[ " $* " == *' --json '* ]]; then json_error ready invalid-options
    else usage >&2; exit 2; fi ;;
  doctor)
    offline=0; json=0
    for option in "$@"; do [[ $option == --json ]] && json=1; done
    while (( $# )); do
      case $1 in
        --offline) offline=1 ;;
        --json) ;;
        *) (( json )) && json_error doctor invalid-options; usage >&2; exit 2 ;;
      esac
      shift
    done
    cmd_doctor "$offline" "$json"
    ;;
  exec) cmd_exec "$@" ;;
  codex) cmd_codex "$@" ;;
  direct) cmd_direct "$@" ;;
  diagnose) cmd_diagnose "$@" ;;
  # v0.2.1 compatibility aliases; intentionally omitted from help/completion/docs.
  test-url) cmd_diagnose_url test-url "$@" ;;
  inspect-process) cmd_diagnose_process process inspect-process "$@" ;;
  inspect-name) cmd_diagnose_process name inspect-name "$@" ;;
  rules) cmd_rules "$@" ;;
  controller|nodes|groups|select|latency|connections|traffic|ui|dashboard|tui|override|manual|providers|provider|dns|mode|subscription)
    cmd_controller "$command_name" "$@" ;;
  logs|log) cmd_logs "$@" ;;
  update)
    _muc_require_safe_module "$_muc_lib_dir/update.py" || exit 2
    command -v python3 >/dev/null 2>&1 || { _muc_err 'update requires Python 3.8+'; exit 2; }
    exec python3 -B "$_muc_lib_dir/update.py" --install-root "${MIHOMO_USERCTL_INSTALL_ROOT:-$_muc_lib_dir}" --current-version "$MIHOMO_USERCTL_VERSION" "$@"
    ;;
  version|--version|-V) (( $# == 0 )) || { usage >&2; exit 2; }; cmd_version ;;
  help|--help|-h) usage ;;
  *) _muc_err "unknown command: $command_name"; usage >&2; exit 2 ;;
esac
